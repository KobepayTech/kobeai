{
  "version": 2,
  "description": "Canonical K9 model registry. Every script, service and the desktop app resolves model locations from this file; never hard-code model paths. Paths are relative to their root and use forward slashes.",
  "roots": {
    "base": {
      "path": "C:\\KobeOS\\Models",
      "env": "KOBEOS_MODELS_ROOT",
      "note": "General KobeOS text models (qwen, deepseek, llama3, mistral, phi3). Owned by KobeOS; K9 only reads them."
    },
    "k9": {
      "path": "C:\\KobeOS\\Models\\k9",
      "env": "K9_MODELS_ROOT",
      "note": "Everything K9-specific."
    }
  },
  "notes": [
    "K9's brain is Qwen3-VL-8B-Instruct (text and images) in brain/qwen3-vl-8b, imported into Ollama and quantized to Q4_K_M by ollama-sync.",
    "Qwen models are managed outside the K9 downloader: it never downloads, moves or modifies qwen.gguf or qwen3-vl-8b.",
    "brain/existing holds hard links to the KobeOS GGUFs, so they take no extra disk space.",
    "Logical agents share resident models; there is not one model process per agent.",
    "Heavy models must be lazy-loaded or served as resident workers according to available GPU memory.",
    "Anything under optional/ is a benchmark or hardware-tier alternative and is never required."
  ],
  "runtime": {
    "python": {
      "executable": "C:\\KobeOS\\vision-env\\Scripts\\python.exe",
      "env": "K9_PYTHON",
      "note": "Python that runs services/k9-runtime (CPU PyTorch, Ultralytics, OpenCV)."
    },
    "k9_runtime": {
      "host": "127.0.0.1",
      "port": 8766,
      "note": "Local K9 model runtime (services/k9-runtime) for detection, tracking, faces, ReID and VAD."
    },
    "ollama": {
      "note": "K9's brain runs through Ollama, built from the registry files below by `node scripts/k9-models.mjs ollama-sync`. The api-server uses the first of these that Ollama has; OLLAMA_MODEL pins one instead.",
      "text_model": "qwen3_vl_8b",
      "text_fallbacks": ["qwen", "mistral", "llama3", "phi3", "deepseek"],
      "vision_note": "Models that can read a picture. The paper reader (photographed class lists and subject-option sheets) and any image question go here; a school without one types the names in by hand instead.",
      "vision_model": "qwen3_vl_8b",
      "vision_fallbacks": []
    }
  },
  "layout": {
    "directories": [
      "brain",
      "brain/existing",
      "tencent/agents",
      "tencent/vision",
      "tencent/ocr",
      "tencent/memory",
      "detection",
      "pose",
      "tracking",
      "reid",
      "reid/osnet-ain",
      "face",
      "ocr",
      "audio",
      "embeddings",
      "tts",
      "optional/detection",
      "optional/vision",
      "optional/ocr"
    ],
    "relocate": [
      {
        "from": "tencent/agents/hunyuan-0.5b-instruct",
        "to": "optional/unused/hunyuan-0.5b-instruct",
        "note": "Not used by K9 (Hunyuan-4B covers this role) — safe to delete to reclaim disk space."
      },
      {
        "from": "tencent/agents/hunyuan-7b-instruct",
        "to": "optional/unused/hunyuan-7b-instruct",
        "note": "Not used by K9 and only partially downloaded — safe to delete to reclaim disk space."
      }
    ],
    "redundant_hard_links": [
      "brain/existing/qwen.gguf",
      "brain/legacy"
    ],
    "remove_if_empty": [
      "brain/legacy",
      "vision",
      "runtimes",
      "optional/brain"
    ]
  },
  "models": {
    "qwen": {
      "category": "brain",
      "role": "KobeOS text model (Qwen2.5-7B-Instruct) — K9's first fallback brain",
      "root": "base",
      "path": "qwen.gguf",
      "kind": "file",
      "required": true,
      "source": { "type": "external", "note": "Owned by KobeOS at the models root; K9 never downloads or modifies it." },
      "ollama": { "name": "k9-qwen", "parameters": { "temperature": 0.4, "num_ctx": 8192 } }
    },
    "deepseek": {
      "category": "brain",
      "role": "reasoning fallback",
      "path": "brain/existing/deepseek.gguf",
      "kind": "file",
      "required": true,
      "source": { "type": "link", "from": "base:deepseek.gguf" },
      "ollama": { "name": "k9-deepseek", "parameters": { "temperature": 0.4, "num_ctx": 8192 } }
    },
    "llama3": {
      "category": "brain",
      "role": "offline text fallback",
      "path": "brain/existing/llama3.gguf",
      "kind": "file",
      "required": true,
      "source": { "type": "link", "from": "base:llama3.gguf" },
      "ollama": { "name": "k9-llama3", "parameters": { "temperature": 0.4, "num_ctx": 8192 } }
    },
    "mistral": {
      "category": "brain",
      "role": "offline text fallback",
      "path": "brain/existing/mistral.gguf",
      "kind": "file",
      "required": true,
      "source": { "type": "link", "from": "base:mistral.gguf" },
      "ollama": { "name": "k9-mistral", "parameters": { "temperature": 0.4, "num_ctx": 8192 } }
    },
    "phi3": {
      "category": "brain",
      "role": "small offline text fallback",
      "path": "brain/existing/phi3.gguf",
      "kind": "file",
      "required": true,
      "source": { "type": "link", "from": "base:phi3.gguf" },
      "ollama": { "name": "k9-phi3", "parameters": { "temperature": 0.4, "num_ctx": 8192 } }
    },

    "youtu_llm_2b": {
