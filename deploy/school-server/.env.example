# =============================================================================
# KobeAI School Server — environment configuration
# Copy to `.env` and fill in real values before running docker compose.
# install.sh will do this automatically and generate a strong SESSION_SECRET.
# =============================================================================

# --- Database ----------------------------------------------------------------
POSTGRES_USER=kobeai
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=kobeai

# --- API server --------------------------------------------------------------
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# AI provider: "canned" (default mock answers), "ollama" (local LLM), or "openai"
AI_PROVIDER=ollama
OLLAMA_MODEL=mistral:7b

# --- KobeVision / camera attendance ------------------------------------------
# Shared credential between the backend and KobeVision.
# Generate with: openssl rand -hex 32
KOBEVISION_SHARED_SECRET=

# Encryption key for locally stored biometric templates.
# Generate with:
# python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
VISION_TEMPLATE_KEY=

# High-accuracy default profile. Model weights are NOT bundled. Put a properly
# licensed InsightFace-compatible pack under:
# deploy/school-server/data/vision/insightface/models/antelopev2
VISION_MODEL_PACK=antelopev2

# CPUExecutionProvider boots on any school server. On an NVIDIA host with the
# NVIDIA Container Toolkit enabled, use CUDAExecutionProvider and enable the
# GPU reservation in docker-compose.yml.
VISION_EXECUTION_PROVIDER=CPUExecutionProvider
VISION_FACE_MATCH_THRESHOLD=0.60
VISION_DETECTION_THRESHOLD=0.60
VISION_CAMERA_SAMPLE_FPS=1.0
VISION_EVENT_DEDUP_SECONDS=15

# RTSP cameras are deployment secrets. camera_id values must also be registered
# through /api/v1/presence/cameras and mapped to campus zones.
# Example:
# VISION_CAMERAS_JSON=[{"camera_id":"form2a-front","url":"rtsp://user:pass@10.0.0.21/stream1","sample_fps":1.0}]
VISION_CAMERAS_JSON=[]

# Timetable-aware location checkpoint engine.
SCHOOL_TIMEZONE=Africa/Dar_es_Salaam
PRESENCE_CHECKPOINT_MINUTES=30
PRESENCE_MATCH_THRESHOLD=0.86
PRESENCE_EXPECTED_ZONE_LOOKBACK_MINUTES=10
PRESENCE_CAMPUS_SEARCH_LOOKBACK_MINUTES=30

# --- Public URL --------------------------------------------------------------
# What the watches and parents type into their browser to reach this server.
# Usually the school server's LAN IP, e.g. http://192.168.1.100
SERVER_URL=http://192.168.1.100

# --- TLS (optional) ----------------------------------------------------------
# Only needed if you start the stack with the TLS overlay:
#   docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d
# DOMAIN must be a real DNS name pointing at this server's public IP, and
# ports 80 + 443 must be reachable from the internet for Let's Encrypt to
# issue a cert. Leave blank for LAN-only HTTP deployments.
DOMAIN=
ADMIN_EMAIL=admin@example.com
